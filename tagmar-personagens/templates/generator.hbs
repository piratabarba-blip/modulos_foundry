<div class="tg-shell">
 <header class="tg-heading"><h2><i class="fa-solid fa-user-plus" aria-hidden="true"></i> Gerador de Personagens e PNJs</h2><p>Monte a ficha. Confira a prévia. Preserve suas escolhas.</p></header>
 <nav class="tg-tabs" aria-label="Tipo da ficha">
  <button type="button" data-action="do" data-do="tab" data-type="Personagem" class="{{#if personagem}}active{{/if}}"><i class="fa-solid fa-user"></i> Personagens</button>
  <button type="button" data-action="do" data-do="tab" data-type="NPC" class="{{#if pnj}}active{{/if}}"><i class="fa-solid fa-users"></i> Não Jogadores (PNJs)</button>
 </nav>
 <div class="tg-layout">
 <aside class="tg-options">
  <h2>Montar a ficha <button class="tg-help" type="button" data-tooltip="{{help.choices}}" data-tooltip-direction="RIGHT" aria-label="Ajuda para montar a ficha">?</button></h2>
  <p class="tg-hint">Escolha os dados. Gere uma prévia e trave o que quiser manter.</p>
  <label>Nome <button type="button" class="tg-help" data-tooltip="{{help.name}}" data-tooltip-direction="RIGHT" aria-label="Ajuda sobre o nome">?</button><span class="tg-field"><input data-field="name" value="{{draft.name}}" placeholder="Digite um nome" maxlength="120"><button type="button" data-action="do" data-do="lock" data-key="name" class="tg-lock {{#if locks.name}}locked{{/if}}" aria-pressed="{{#if locks.name}}true{{else}}false{{/if}}" title="Travar nome"><i class="fa-solid {{#if locks.name}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></span></label>
  <label>Raça <span class="tg-field"><select data-field="race" {{#if locks.race}}disabled{{/if}}>{{#each races}}<option value="{{key}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}</option>{{/each}}</select><button type="button" data-action="do" data-do="lock" data-key="race" class="tg-lock {{#if locks.race}}locked{{/if}}" title="Travar raça"><i class="fa-solid {{#if locks.race}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></span></label>
  <label>Profissão <span class="tg-field"><select data-field="profession" {{#if locks.profession}}disabled{{/if}}>{{#each professions}}<option value="{{key}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}</option>{{/each}}</select><button type="button" data-action="do" data-do="lock" data-key="profession" class="tg-lock {{#if locks.profession}}locked{{/if}}" title="Travar profissão"><i class="fa-solid {{#if locks.profession}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></span></label>
  <label>Estágio (1–20) <span class="tg-field"><input data-field="stage" type="number" min="1" max="20" step="1" value="{{draft.stage}}" {{#if locks.stage}}disabled{{/if}}><button type="button" data-action="do" data-do="lock" data-key="stage" class="tg-lock {{#if locks.stage}}locked{{/if}}" title="Travar estágio"><i class="fa-solid {{#if locks.stage}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></span></label>
  <label>Especialização <button class="tg-help" type="button" data-tooltip="{{help.specialization}}" data-tooltip-direction="RIGHT" aria-label="Ajuda sobre especialização">?</button><span class="tg-field"><select data-field="specialization" {{#if locks.specialization}}disabled{{/if}}>{{#each specializations}}<option value="{{key}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}</option>{{/each}}</select><button type="button" data-action="do" data-do="lock" data-key="specialization" class="tg-lock {{#if locks.specialization}}locked{{/if}}" title="Travar especialização"><i class="fa-solid {{#if locks.specialization}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></span></label>
  {{#if restriction}}<p class="tg-hint">{{restriction}}</p>{{/if}}
  <label>Kit de pertences <button class="tg-help" type="button" data-tooltip="{{help.kit}}" data-tooltip-direction="RIGHT" aria-label="Ajuda sobre kits">?</button><select data-field="kit" {{#if locks.equipment}}disabled{{/if}}>{{#each kits}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
  <details class="tg-identity-options" data-section="identity" {{#if identityOpen}}open{{/if}}><summary>Identidade sugerida <button type="button" class="tg-help" data-tooltip="{{help.identity}}" data-tooltip-direction="RIGHT" aria-label="Ajuda sobre identidade">?</button></summary>
   <label>Classe social <input type="text" value="Livre" readonly></label>
   {{#each identityFields}}<label>{{label}}<span class="tg-field"><input data-field="identity:{{key}}" type="{{type}}" min="0" step="any" value="{{value}}"><button type="button" data-action="do" data-do="lock" data-key="identity:{{key}}" class="tg-lock {{#if locked}}locked{{/if}}" title="Travar {{label}}"><i class="fa-solid {{#if locked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></span></label>{{/each}}
   <label>Deus <span class="tg-field"><select data-field="identity:deus">{{#each deities}}<option value="{{key}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}</option>{{/each}}</select><button type="button" data-action="do" data-do="lock" data-key="identity:deus" class="tg-lock {{#if deityLocked}}locked{{/if}}" title="Travar deus"><i class="fa-solid {{#if deityLocked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></span></label>
  </details>
  <label>Distribuição <select data-field="distribution">{{#each distribution}}<option value="{{key}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}</option>{{/each}}</select></label>
  <label>EH <button type="button" class="tg-help" data-tooltip="{{help.eh}}" data-tooltip-direction="RIGHT" aria-label="Ajuda sobre EH">?</button><select data-field="ehMode">{{#each ehModes}}<option value="{{key}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}</option>{{/each}}</select></label>
  <button type="button" class="tg-primary" data-action="do" data-do="generate"><i class="fa-solid fa-dice"></i> {{#if preview}}Sortear novamente{{else}}Gerar prévia{{/if}}</button>
  <button type="button" class="tg-subtle" data-action="do" data-do="unlock">Abrir todas as travas <i class="fa-solid fa-lock-open"></i></button>
  <p class="tg-note">Prévia 0.1 · Distribuição por pontos. Você decide a identidade, a história e os requisitos narrativos.</p>
 </aside>
 <main class="tg-preview">
  <h2>Prévia <button type="button" class="tg-help" data-tooltip="{{help.locks}}" data-tooltip-direction="LEFT" aria-label="Ajuda sobre as travas">?</button></h2>
  {{#if error}}<p class="tg-error" role="alert">{{error}}</p>{{/if}}
  <p class="tg-dirty" {{#unless dirty}}hidden{{/unless}}>Configuração alterada. Gere novamente para atualizar a prévia.</p>
  {{#if preview}}
   <div class="tg-identity"><strong>{{preview.actor.name}}</strong><span>{{preview.actor.system.raca}} · {{preview.actor.system.profissao}} · Estágio {{preview.actor.system.estagio}}</span>{{#if preview.actor.system.especializacao}}<small>{{preview.actor.system.especializacao}}</small>{{/if}}<small>{{preview.actor.system.classe_social}} · {{preview.actor.system.idade}} anos · {{preview.actor.system.altura}} m · {{preview.actor.system.peso}} kg · Deus: {{preview.actor.system.deus}}</small></div>
   <div class="tg-stats">{{#each stats}}<span>{{label}}<b>{{value}}</b></span>{{/each}}</div>
   <details data-section="attributes" {{#if attributesOpen}}open{{/if}}>
    <summary>Atributos <button type="button" class="tg-help" data-tooltip="{{help.attrs}}" aria-label="Ajuda sobre atributos">?</button></summary>
    <div class="tg-attributes">{{#each attributes}}<label>{{key}}<input type="number" data-field="attr:{{key}}" value="{{value}}" min="-4" max="10" step="1"><span>Racial {{racial}} <button type="button" class="tg-lock {{#if locked}}locked{{/if}}" data-action="do" data-do="lock" data-key="attr:{{key}}" title="Travar {{key}}"><i class="fa-solid {{#if locked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></span></label>{{/each}}</div>
   </details>
   <div class="tg-balances" title="Pontos restantes para comprar na ficha">{{#each balances}}<span>{{label}}: <b>{{value}}</b></span>{{/each}}</div>
   <div class="tg-row"><span>EH: {{preview.actor.system.eh.max}} <button type="button" class="tg-help" data-tooltip="{{help.eh}}" aria-label="Ajuda sobre a EH sorteada">?</button></span><button type="button" class="tg-lock {{#if ehLocked}}locked{{/if}}" data-action="do" data-do="lock" data-key="eh" title="Conservar os dados de EH"><i class="fa-solid {{#if ehLocked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></div>
   <details class="tg-eh"><summary>Conferir evolução de EH</summary><p>{{ehInfo}}</p></details>
   <div class="tg-row"><span>Grupos de armas <button type="button" class="tg-help" data-tooltip="{{help.groups}}" aria-label="Ajuda sobre grupos de armas">?</button></span><button type="button" class="tg-lock {{#if groupsLocked}}locked{{/if}}" data-action="do" data-do="lock" data-key="groups" title="Travar grupos de armas"><i class="fa-solid {{#if groupsLocked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></div>
   <div class="tg-groups">{{#each groups}}<span>{{key}} <b>{{value}}</b></span>{{else}}<small>Nenhum grupo comprado.</small>{{/each}}</div>
   {{#each sections}}
    <details data-section="{{key}}" {{#if open}}open{{/if}}>
     <summary><span>{{label}} <small>({{count}})</small> <button type="button" class="tg-help" data-tooltip="{{help}}" aria-label="Ajuda sobre {{label}}">?</button></span><button type="button" class="tg-lock {{#if locked}}locked{{/if}}" data-action="do" data-do="lock" data-key="{{key}}" title="Travar {{label}}"><i class="fa-solid {{#if locked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></summary>
     <table><thead><tr><th>Item</th><th>Nível</th><th>Total / dados</th><th>Editar</th></tr></thead><tbody>{{#each items}}<tr><td><img src="{{img}}" alt="" loading="lazy"><span>{{name}}{{#if innate}} <small>(nata)</small>{{/if}}</span></td><td>{{#if canLevel}}{{level}}{{else}}—{{/if}}</td><td>{{total}}</td><td class="tg-actions">{{#if canLevel}}{{#unless innate}}<button type="button" data-action="do" data-do="item-down" data-key="{{key}}" title="Reduzir nível">−</button><button type="button" data-action="do" data-do="item-up" data-key="{{key}}" title="Aumentar nível">+</button>{{/unless}}{{/if}}<button type="button" class="tg-lock {{#if locked}}locked{{/if}}" data-action="do" data-do="lock" data-key="item:{{key}}" title="Travar {{name}}"><i class="fa-solid {{#if locked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button>{{#unless innate}}<button type="button" data-action="do" data-do="item-remove" data-key="{{key}}" title="Retirar {{name}}"><i class="fa-solid fa-trash"></i></button>{{/unless}}</td></tr>{{else}}<tr><td colspan="4">Nenhum item neste bloco.</td></tr>{{/each}}</tbody></table>
     <details class="tg-add"><summary>+ Escolher outro item</summary><input type="search" data-item-search="{{key}}" placeholder="Digite para filtrar..."><div class="tg-field"><select data-add="{{key}}"><option value="">Escolha um item</option>{{#each candidates}}<option value="{{key}}">{{name}}</option>{{/each}}</select><button type="button" data-action="do" data-do="item-add" data-section="{{key}}">Adicionar</button></div><small>Usa os pontos disponíveis. Para trocar, retire ou diminua outro item primeiro.</small></details>
    </details>
   {{/each}}
   {{#if preview.warnings}}<details class="tg-review"><summary>Conferir observações ({{preview.warnings.length}})</summary>{{#each preview.warnings}}<p>{{this}}</p>{{/each}}</details>{{/if}}
  {{else}}<div class="tg-empty"><i class="fa-solid fa-user-plus"></i><p>Seu próximo personagem começa aqui.</p><small>Selecione raça, profissão e estágio e clique em Gerar prévia.</small></div>{{/if}}
 </main>
 </div>
 <footer class="tg-footer"><label>Criar na pasta <select data-field="folder">{{#each folders}}<option value="{{key}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}</option>{{/each}}</select></label><button type="button" class="tg-help" data-tooltip="{{help.create}}" aria-label="Ajuda para criar a ficha">?</button>{{#if created}}<button type="button" class="tg-primary" data-action="do" data-do="open">Abrir ficha criada</button>{{else}}<button type="button" class="tg-primary" data-action="do" data-do="create" {{#unless preview}}disabled{{/unless}} {{#if dirty}}disabled{{/if}} {{#if busy}}disabled{{/if}}><i class="fa-solid fa-user-plus"></i> Criar ficha no mundo</button>{{/if}}</footer>
</div>
