<div class="tg-shell">
 <header class="tg-heading"><h2><i class="fa-solid fa-user-plus" aria-hidden="true"></i> Gerador de Personagens, PNJs e Criaturas</h2><p>Monte a ficha. Confira a prévia. Preserve suas escolhas.</p></header>
 <nav class="tg-tabs" aria-label="Tipo da ficha">
  <button type="button" data-action="do" data-do="tab" data-type="Personagem" class="{{#if personagem}}active{{/if}}"><i class="fa-solid fa-user"></i> Personagens</button>
  <button type="button" data-action="do" data-do="tab" data-type="NPC" class="{{#if pnj}}active{{/if}}"><i class="fa-solid fa-users"></i> Não Jogadores (PNJs)</button>
  <button type="button" data-action="do" data-do="tab" data-type="Creature" class="{{#if criatura}}active{{/if}}"><i class="fa-solid fa-dragon"></i> Criaturas — Variação de nível</button>
  <button type="button" data-action="do" data-do="tab" data-type="NewCreature" class="{{#if novaCriatura}}active{{/if}}"><i class="fa-solid fa-paw"></i> Criar sua criatura</button>
 </nav>
 {{#if novaCriatura}}
 <div class="tg-layout tg-new-creature">
  <aside class="tg-options">
   <h2>Criar do zero <button type="button" class="tg-help" data-tooltip="{{help.build}}" data-tooltip-direction="RIGHT" aria-label="Ajuda para criar do zero">?</button></h2>
   <p class="tg-hint">Defina a construção. Ajuste o perfil e trave o que quiser preservar.</p>
   <label>Nome <span class="tg-field"><input data-n-field="name" value="{{draft.name}}" placeholder="Nome da nova criatura" maxlength="120"><button type="button" data-action="do" data-do="n-lock" data-key="name" class="tg-lock {{#if locks.name}}locked{{/if}}" title="Travar nome"><i class="fa-solid {{#if locks.name}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></span></label>
   <label>Estágio (0–50) <span class="tg-field"><input type="number" min="0" max="50" step="1" data-n-field="stage" value="{{draft.stage}}" {{#if locks.stage}}disabled{{/if}}><button type="button" data-action="do" data-do="n-lock" data-key="stage" class="tg-lock {{#if locks.stage}}locked{{/if}}" title="Travar estágio"><i class="fa-solid {{#if locks.stage}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></span></label>
   <section class="tg-book-primary" aria-label="Construção pelo Livro 3.02"><h3>Construção — Livro 3.02 <button type="button" class="tg-help" data-tooltip="{{help.book}}" data-tooltip-direction="RIGHT" aria-label="Ajuda sobre regras de criação">?</button></h3>
    <div class="tg-book-measures"><label>Peso (kg)<input type="number" data-n-field="weight" value="{{draft.weight}}" min="0.001" step="any" placeholder="Sugerir pelo porte"></label><label>Altura (m)<input type="number" data-n-field="height" value="{{draft.height}}" min="0.01" step="any" placeholder="Sugerir pelo porte"></label></div>
    <label>Combatividade<select data-n-field="combativeness">{{#each combativities}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    <label>Organização natural<select data-n-field="organization">{{#each organizations}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    <label>Natureza corpórea <button type="button" class="tg-help" data-tooltip="{{help.body}}" data-tooltip-direction="RIGHT" aria-label="Ajuda sobre natureza corpórea">?</button><select data-n-field="corporeality">{{#each corporealities}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    <label>Criatura construída<select data-n-field="construction">{{#each constructions}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    <label>Dano natural <button type="button" class="tg-help" data-tooltip="{{help.natural}}" data-tooltip-direction="RIGHT" aria-label="Ajuda sobre dano por peso">?</button><select data-n-field="damageRange">{{#each damageRanges}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    <label>Moral <button type="button" class="tg-help" data-tooltip="{{help.morale}}" data-tooltip-direction="RIGHT" aria-label="Ajuda sobre Moral">?</button><select data-n-field="moralMode">{{#each morales}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    <label>Velocidade Base (VB) <button type="button" class="tg-help" data-tooltip="{{help.speed}}" data-tooltip-direction="RIGHT" aria-label="Ajuda sobre velocidade">?</button><input type="number" data-n-field="speedVb" value="{{speedVbValue}}" min="0" step="any" placeholder="Opcional: sugerir VB"></label>
    <small>Vazios: peso e altura sugeridos pelo porte. Confira antes de gerar.</small>
   </section>
   <details data-section="new:profile" {{#if profileOpen}}open{{/if}}><summary>Perfil e sugestões</summary>
   <label>Porte <button type="button" class="tg-help" data-tooltip="{{help.size}}" data-tooltip-direction="RIGHT" aria-label="Ajuda sobre porte">?</button><select data-n-field="size">{{#each sizes}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
   <label>Grupo <button type="button" class="tg-help" data-tooltip="{{help.group}}" data-tooltip-direction="RIGHT" aria-label="Ajuda sobre grupo">?</button><select data-n-field="group">{{#each groups}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
   <label>Inteligência <button type="button" class="tg-help" data-tooltip="{{help.nature}}" data-tooltip-direction="RIGHT" aria-label="Ajuda sobre inteligência">?</button><select data-n-field="intelligence">{{#each intellects}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
   <label>Capacidade mágica <select data-n-field="magic">{{#each magics}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
   <label>Forma do corpo <button type="button" class="tg-help" data-tooltip="{{help.anatomy}}" data-tooltip-direction="RIGHT" aria-label="Ajuda sobre corpo">?</button><select data-n-field="anatomy">{{#each bodies}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
   <label>Afinidade <button type="button" class="tg-help" data-tooltip="{{help.element}}" data-tooltip-direction="RIGHT" aria-label="Ajuda sobre afinidade">?</button><select data-n-field="element">{{#each elements}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
   <label>Perfil <select data-n-field="focus">{{#each focuses}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
   </details>
   <details data-section="new:spell-source" {{#if spellSourceOpen}}open{{/if}}><summary>Origem das magias <button type="button" class="tg-help" data-tooltip="{{help.spells}}" data-tooltip-direction="RIGHT" aria-label="Ajuda sobre dons e Karma">?</button></summary><label>Como usa a magia<select data-n-field="magicSource">{{#each magicSources}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label>Usos por dia de cada dom<input type="number" data-n-field="usesPerDay" value="{{draft.usesPerDay}}" min="1" step="1" placeholder="Sugestão: 1"></label><small>Registrado na biografia; controle de usos manual. Sem magia, esta opção não concede poderes.</small></details>
   <label class="tg-check"><input type="checkbox" data-n-field="variation" {{#if draft.variation}}checked{{/if}}> Variar os valores sugeridos</label>
   <details data-section="new:identity" {{#if identityOpen}}open{{/if}}><summary>Imagem e descrição</summary><label>Imagem (caminho no Foundry)<input type="text" data-n-field="img" value="{{draft.img}}" placeholder="Opcional: worlds/.../criatura.webp"></label><label>Descrição<textarea data-n-field="description" rows="4" placeholder="Aparência, comportamento e história">{{draft.description}}</textarea></label></details>
   <button type="button" class="tg-primary" data-action="do" data-do="n-generate" {{#if busy}}disabled{{/if}}><i class="fa-solid fa-dice"></i> {{#if preview}}Sugerir novamente{{else}}Gerar prévia{{/if}}</button>
   <button type="button" class="tg-subtle" data-action="do" data-do="n-unlock">Abrir todas as travas <i class="fa-solid fa-lock-open"></i></button>
   <p class="tg-note">{{bookSource}}. Sugestões editáveis; revise anatomia, poderes e equilíbrio.</p>
  </aside>
  <main class="tg-preview">
   <h2>Sua criatura <button type="button" class="tg-help" data-tooltip="{{help.locks}}" data-tooltip-direction="LEFT" aria-label="Ajuda sobre travas">?</button></h2>
   <p class="tg-profile-summary">{{profileLabel}}</p>
   {{#if error}}<p class="tg-error" role="alert">{{error}}</p>{{/if}}
   <p class="tg-dirty" {{#unless dirty}}hidden{{/unless}}>Configuração alterada. Gere novamente para atualizar a prévia.</p>
   {{#if preview}}
    <div class="tg-identity"><strong>{{preview.actor.name}}</strong><span>Estágio {{preview.actor.system.estagio}} · Nova ficha de Não Jogador (PNJ)</span><small>Altura sugerida {{preview.actor.system.altura}} m · Peso sugerido {{preview.actor.system.peso}} kg · Token {{preview.actor.prototypeToken.width}} × {{preview.actor.prototypeToken.height}}</small></div>
    <p class="tg-hint">{{bookSummary}}</p>
    <div class="tg-row"><span>Atributos</span><button type="button" class="tg-lock {{#if attributesLocked}}locked{{/if}}" data-action="do" data-do="n-lock" data-key="attributes" title="Travar atributos"><i class="fa-solid {{#if attributesLocked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></div>
    <div class="tg-attributes">{{#each attributes}}<label>{{key}}<input type="number" data-n-edit="attr:{{key}}" value="{{value}}" step="1"><span><button type="button" data-action="do" data-do="n-lock" data-key="attr:{{key}}" class="tg-lock {{#if locked}}locked{{/if}}" title="Travar {{key}}"><i class="fa-solid {{#if locked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></span></label>{{/each}}</div>
    <div class="tg-row"><span>Recursos e movimento <button type="button" class="tg-help" data-tooltip="{{help.resources}}" aria-label="Ajuda sobre recursos">?</button></span><button type="button" class="tg-lock {{#if resourcesLocked}}locked{{/if}}" data-action="do" data-do="n-lock" data-key="resources" title="Travar recursos"><i class="fa-solid {{#if resourcesLocked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></div>
    <div class="tg-new-resources">{{#each stats}}<label>{{label}}<span class="tg-field"><input type="number" data-n-edit="{{key}}" value="{{value}}" min="0" step="1"><button type="button" data-action="do" data-do="n-lock" data-key="{{lock}}" class="tg-lock {{#if locked}}locked{{/if}}" title="Travar {{label}}"><i class="fa-solid {{#if locked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></span></label>{{/each}}</div>
    <p class="tg-hint">Defesa: {{preview.actor.system.d_ativa.categoria}}{{preview.actor.system.d_ativa.valor}} · ABS: {{preview.actor.system.absorcao.max}} · Ajustadas nas proteções abaixo.</p>
   {{else}}<p class="tg-hint">Escolha componentes nos blocos abaixo ou deixe o gerador sugerir. Só será criada uma ficha quando você confirmar a prévia.</p>{{/if}}
    {{#each blocks}}<details data-section="new:{{key}}" {{#if open}}open{{/if}}><summary>{{label}} ({{items.length}})<button type="button" class="tg-lock {{#if locked}}locked{{/if}}" data-action="do" data-do="n-lock" data-key="{{key}}" title="Travar {{label}}"><i class="fa-solid {{#if locked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></summary>
     <div class="tg-component-plan"><label>Como escolher <button type="button" class="tg-help" data-tooltip="{{../help.parts}}" aria-label="Ajuda sobre escolhas">?</button><select data-n-plan="modes" data-n-block="{{key}}">{{#each modes}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{#if random}}<label>{{#if skills}}Habilidades com nível{{else}}Quantidade total{{/if}}<input type="number" min="0" max="20" step="1" data-n-plan="counts" data-n-block="{{key}}" value="{{count}}"></label>{{/if}}</div>
     <p class="tg-hint">{{hint}}</p>
     {{#if chosen.length}}<div class="tg-manual-picks"><small>Minhas escolhas:</small>{{#each chosen}}<span>{{name}} <button type="button" data-action="do" data-do="n-unpick" data-key="{{key}}" title="Retirar escolha {{name}}"><i class="fa-solid fa-xmark"></i></button></span>{{/each}}</div>{{/if}}
     {{#if skills}}<div class="tg-skill-grid">{{#each skillGroups}}<section class="tg-skill-group"><h3>{{label}}</h3><table class="tg-skill-table"><thead><tr><th>Habilidade</th><th>Nível</th><th>Total</th><th>Ajustar</th></tr></thead><tbody>{{#each items}}<tr><td><span class="tg-skill-name"><img src="{{img}}" alt="" loading="lazy"><span>{{name}}{{#if noLevel}} <small title="Exige nível para usar">*</small>{{/if}}</span></span></td><td><input type="number" data-n-item="{{key}}" data-n-prop="level" min="0" max="100" step="1" value="{{level}}" aria-label="Nível de {{name}}" {{#unless editable}}disabled{{/unless}}></td><td>{{total}}</td><td class="tg-actions"><button type="button" data-action="do" data-do="n-lock" data-key="item:{{key}}" class="tg-lock {{#if locked}}locked{{/if}}" title="Travar {{name}}" {{#unless editable}}disabled{{/unless}}><i class="fa-solid {{#if locked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button><button type="button" data-action="do" data-do="n-remove" data-key="{{key}}" title="Zerar nível de {{name}}; manter na ficha" {{#unless editable}}disabled{{/unless}}><i class="fa-solid fa-rotate-left"></i></button></td></tr>{{else}}<tr><td colspan="4">Nenhuma habilidade neste grupo.</td></tr>{{/each}}</tbody></table></section>{{/each}}</div><p class="tg-hint">Edite o nível na própria linha. O cadeado preserva sua escolha ao gerar novamente. ↶ zera o nível sem excluir a habilidade. * Exige treinamento para usar.</p>{{else}}
     <div class="tg-new-items">{{#each items}}<div class="tg-new-item">
      <span class="tg-component-name"><img src="{{img}}" alt="" loading="lazy"><span>{{name}}</span></span>
      <small class="tg-component-total">{{summary}}</small>
      <div class="tg-new-item-fields">{{#if attack}}<label title="Dano-base a 100%, antes dos bônus da ficha">Dano 100% <input type="number" data-n-item="{{key}}" data-n-prop="damage" min="0" step="1" value="{{damage}}" aria-label="Dano-base a 100% de {{name}}"></label>{{/if}}{{#if protection}}<label>ABS <input type="number" data-n-item="{{key}}" data-n-prop="abs" value="{{abs}}" min="0" step="1" aria-label="ABS de {{name}}"></label><label>Defesa <input type="number" data-n-item="{{key}}" data-n-prop="defense" value="{{defense}}" step="1" aria-label="Defesa-base de {{name}}"></label>{{/if}}{{#if canLevel}}<label>{{#if attack}}Proficiência{{else}}Nível{{/if}} <input type="number" data-n-item="{{key}}" data-n-prop="level" min="0" max="100" step="1" value="{{level}}" aria-label="Nível de {{name}}"></label>{{/if}}</div>
      <span class="tg-actions"><button type="button" data-action="do" data-do="n-lock" data-key="item:{{key}}" class="tg-lock {{#if locked}}locked{{/if}}" title="Travar {{name}}"><i class="fa-solid {{#if locked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button><button type="button" data-action="do" data-do="n-remove" data-key="{{key}}" title="Remover {{name}}"><i class="fa-solid fa-trash"></i></button></span>
     </div>{{else}}<p class="tg-hint">Nenhum componente neste bloco.</p>{{/each}}</div>
     <div class="tg-new-add tg-item-picker" data-item-picker><div class="tg-combo-field"><input type="search" role="combobox" aria-autocomplete="list" aria-expanded="false" autocomplete="off" data-n-search="{{key}}" placeholder="Procurar e escolher componente..." aria-label="Procurar {{label}}"><button type="button" data-picker-toggle aria-label="Abrir opções de {{label}}" tabindex="-1"><i class="fa-solid fa-caret-down" aria-hidden="true"></i></button></div><select data-n-add="{{key}}" aria-label="Adicionar {{label}}" hidden><option value="">Escolha um componente</option>{{#each candidates}}<option value="{{key}}" title="{{title}}">{{label}}</option>{{/each}}</select><button type="button" data-action="do" data-do="n-add" data-section="{{key}}"><i class="fa-solid fa-plus"></i> Adicionar</button><div class="tg-item-options" role="listbox" aria-label="Opções de {{label}}" hidden></div></div>
     {{/if}}
    </details>{{/each}}
    {{#if preview}}<details class="tg-review"><summary>Como conferir a criatura <button type="button" class="tg-help" data-tooltip="{{help.parts}}" aria-label="Ajuda sobre componentes">?</button></summary>{{#each preview.warnings}}<p>{{this}}</p>{{/each}}<p>{{help.damage}}</p></details>{{/if}}
  </main>
 </div>
 <footer class="tg-footer"><label>Criar na pasta <select data-n-field="folder">{{#each folders}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{#if created}}<button type="button" class="tg-primary" data-action="do" data-do="n-open">Abrir criatura criada</button>{{else}}<button type="button" class="tg-primary" data-action="do" data-do="n-create" {{#unless preview}}disabled{{/unless}} {{#if dirty}}disabled{{/if}} {{#if busy}}disabled{{/if}}><i class="fa-solid fa-paw"></i> Criar criatura no mundo</button>{{/if}}</footer>
 {{else}}
 {{#if criatura}}
 <div class="tg-layout tg-creatures">
  <aside class="tg-options">
   <h2>Adaptar criatura <button type="button" class="tg-help" data-tooltip="{{creatureHelp.source}}" data-tooltip-direction="RIGHT" aria-label="Ajuda sobre criatura-base">?</button></h2>
   <p class="tg-hint">Escolha uma ficha pronta e gere uma versão mais fraca ou mais forte.</p>
   {{#if creatureEmpty}}<p class="tg-error">Nenhum compêndio de criaturas disponível no sistema ativo.</p>{{/if}}
   <label>Compêndio <select data-c-field="pack">{{#each creaturePacks}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
   <div class="tg-creature-picker" data-creature-picker>
    <label for="tg-creature-search">Procurar criatura</label>
    <div class="tg-combo-field"><input id="tg-creature-search" type="text" role="combobox" aria-autocomplete="list" aria-controls="tg-creature-options" aria-expanded="false" autocomplete="off" data-c-search value="{{creatureSearchText}}" placeholder="Digite e escolha na lista..."><button type="button" data-c-toggle aria-label="Abrir lista de criaturas" tabindex="-1"><i class="fa-solid fa-caret-down" aria-hidden="true"></i></button></div>
    <input type="hidden" data-c-field="source" value="{{creatureDraft.source}}">
    <div class="tg-creature-options" id="tg-creature-options" role="listbox" aria-label="Criaturas disponíveis" hidden>{{#each creatureChoices}}<button type="button" id="tg-creature-option-{{@index}}" role="option" tabindex="-1" data-key="{{key}}" aria-selected="{{#if selected}}true{{else}}false{{/if}}">{{label}}</button>{{/each}}<p data-c-empty hidden>Nenhuma criatura encontrada.</p></div>
   </div>
   <label>Nome da variante <span class="tg-field"><input data-c-field="name" value="{{creatureDraft.name}}" placeholder="Opcional: nome sugerido" maxlength="120"><button type="button" class="tg-lock {{#if nameLocked}}locked{{/if}}" data-action="do" data-do="c-lock" data-key="name" title="Travar nome"><i class="fa-solid {{#if nameLocked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></span></label>
   <label>Potência relativa (%) <button type="button" class="tg-help" data-tooltip="{{creatureHelp.factor}}" data-tooltip-direction="RIGHT" aria-label="Ajuda sobre potência relativa">?</button><input type="number" data-c-field="factor" value="{{creatureDraft.factor}}" min="25" max="300" step="5"></label>
   <p class="tg-hint">50%: mais fraca · 100%: base · 150%: mais forte. Sugestão extraoficial.</p>
   <label class="tg-check"><input type="checkbox" data-c-field="variation" {{#if creatureDraft.variation}}checked{{/if}}> Variar recursos e dano em até 10%</label>
   <button type="button" class="tg-primary" data-action="do" data-do="c-generate" {{#unless creatureDraft.source}}disabled{{/unless}} {{#if busy}}disabled{{/if}}><i class="fa-solid fa-dice"></i> {{#if preview}}Gerar novamente{{else}}Gerar prévia{{/if}}</button>
   <button type="button" class="tg-subtle" data-action="do" data-do="c-unlock">Abrir todas as travas <i class="fa-solid fa-lock-open"></i></button>
   <p class="tg-note">Sem comprar profissão ou raça. Preserva ataques naturais, poderes e aparência da original.</p>
  </aside>
  <main class="tg-preview">
   <h2>Original e variante <button type="button" class="tg-help" data-tooltip="{{creatureHelp.locks}}" data-tooltip-direction="LEFT" aria-label="Ajuda sobre travas de criaturas">?</button></h2>
   {{#if error}}<p class="tg-error" role="alert">{{error}}</p>{{/if}}
   <p class="tg-dirty" {{#unless dirty}}hidden{{/unless}}>Configuração alterada. Gere novamente para atualizar a prévia.</p>
   {{#if preview}}
    {{#if sourceIssue}}<p class="tg-error" role="alert">{{sourceIssue}}</p>{{/if}}
    <div class="tg-identity"><strong>{{preview.actor.name}}</strong><span>Base: {{creatureSource.actor.name}} · Potência {{preview.factor}}% · Não Jogador (PNJ)</span><small>{{creatureSource.packLabel}}</small></div>
    <div class="tg-row"><span>Recursos e estágio</span><button type="button" class="tg-lock {{#if resourcesLocked}}locked{{/if}}" data-action="do" data-do="c-lock" data-key="resources" title="Travar recursos"><i class="fa-solid {{#if resourcesLocked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></div>
    <table class="tg-comparison"><thead><tr><th>Valor</th><th>Original</th><th>Variante</th><th>Travar</th></tr></thead><tbody>{{#each comparisons}}<tr><td>{{label}}</td><td>{{original}}</td><td>{{#if editable}}<input type="number" data-c-edit="{{key}}" value="{{value}}" min="0" step="1" aria-label="{{label}} da variante">{{else}}{{value}}{{/if}}</td><td class="tg-actions"><button type="button" class="tg-lock {{#if locked}}locked{{/if}}" data-action="do" data-do="c-lock" data-key="{{lock}}" title="Travar {{label}}"><i class="fa-solid {{#if locked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></td></tr>{{/each}}</tbody></table>
    <details data-section="creature:attributes" {{#if attributesOpen}}open{{/if}}><summary>Atributos preservados <button type="button" class="tg-lock {{#if attributesLocked}}locked{{/if}}" data-action="do" data-do="c-lock" data-key="attributes" title="Travar atributos"><i class="fa-solid {{#if attributesLocked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></summary><div class="tg-attributes">{{#each creatureAttributes}}<label>{{key}}<input type="number" data-c-edit="attr:{{key}}" value="{{value}}" step="1"><span>Base {{original}} <button type="button" class="tg-lock {{#if locked}}locked{{/if}}" data-action="do" data-do="c-lock" data-key="attr:{{key}}" title="Travar {{key}}"><i class="fa-solid {{#if locked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></span></label>{{/each}}</div></details>
    <div class="tg-row"><span>Movimento e iniciativa</span><button type="button" class="tg-lock {{#if movementLocked}}locked{{/if}}" data-action="do" data-do="c-lock" data-key="movement" title="Travar movimento"><i class="fa-solid {{#if movementLocked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></div>
    <div class="tg-movement">{{#each movementFields}}<label>{{label}}<input type="number" data-c-edit="{{key}}" value="{{value}}" min="0" step="1"></label>{{/each}}</div>
    {{#each blocks}}<details data-section="creature:{{key}}" {{#if open}}open{{/if}}><summary>{{label}} ({{items.length}})<button type="button" class="tg-lock {{#if locked}}locked{{/if}}" data-action="do" data-do="c-lock" data-key="{{key}}" title="Travar {{label}}"><i class="fa-solid {{#if locked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></summary>{{#if skills}}<div class="tg-skill-grid">{{#each skillGroups}}<section class="tg-skill-group"><h3>{{label}}</h3><table class="tg-skill-table tg-variant-skills"><thead><tr><th>Habilidade</th><th>Original</th><th>Variante</th><th>Travar</th></tr></thead><tbody>{{#each items}}<tr><td><span class="tg-skill-name"><img src="{{img}}" alt="" loading="lazy"><span>{{name}}</span></span></td><td><span>Nível {{baseLevel}}</span><br><span>Total {{baseTotal}}</span></td><td><span>Nível {{level}}</span><br><span>Total {{total}}</span></td><td class="tg-actions"><button type="button" class="tg-lock {{#if locked}}locked{{/if}}" data-action="do" data-do="c-lock" data-key="item:{{key}}" title="Travar {{name}}"><i class="fa-solid {{#if locked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></td></tr>{{else}}<tr><td colspan="4">Nenhuma habilidade na criatura-base.</td></tr>{{/each}}</tbody></table></section>{{/each}}</div><p class="tg-hint">Preserva as habilidades da criatura-base. Original e Variante mostram os níveis e totais de cada ficha.</p>{{else}}<table class="tg-creature-items"><thead><tr><th>Item</th><th>Original</th><th>Variante</th><th>Travar</th></tr></thead><tbody>{{#each items}}<tr><td><img src="{{img}}" alt="" loading="lazy"><span>{{name}}</span></td><td>{{base}}</td><td>{{value}}</td><td class="tg-actions"><button type="button" class="tg-lock {{#if locked}}locked{{/if}}" data-action="do" data-do="c-lock" data-key="item:{{key}}" title="Travar {{name}}"><i class="fa-solid {{#if locked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></td></tr>{{else}}<tr><td colspan="4">Nenhum item neste bloco.</td></tr>{{/each}}</tbody></table>{{/if}}</details>{{/each}}
    <details class="tg-review"><summary>Poderes e observações <button type="button" class="tg-help" data-tooltip="{{creatureHelp.powers}}" aria-label="Ajuda sobre poderes">?</button></summary>{{#each preview.warnings}}<p>{{this}}</p>{{/each}}</details>
   {{else}}<div class="tg-empty"><i class="fa-solid fa-dragon"></i><p>Uma criatura conhecida, outra versão.</p><small>Escolha a base e ajuste a potência para comparar.</small></div>{{/if}}
  </main>
 </div>
 <footer class="tg-footer"><label>Criar na pasta <select data-c-field="folder">{{#each folders}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><button type="button" class="tg-help" data-tooltip="{{creatureHelp.create}}" aria-label="Ajuda para criar criatura">?</button>{{#if created}}<button type="button" class="tg-primary" data-action="do" data-do="c-open">Abrir criatura criada</button>{{else}}<button type="button" class="tg-primary" data-action="do" data-do="c-create" {{#if sourceIssue}}disabled{{/if}} {{#unless preview}}disabled{{/unless}} {{#if dirty}}disabled{{/if}} {{#if busy}}disabled{{/if}}><i class="fa-solid fa-dragon"></i> Criar criatura no mundo</button>{{/if}}</footer>
 {{else}}
 <div class="tg-layout">
 <aside class="tg-options">
  <h2>Montar a ficha <button class="tg-help" type="button" data-tooltip="{{help.choices}}" data-tooltip-direction="RIGHT" aria-label="Ajuda para montar a ficha">?</button></h2>
  <p class="tg-hint">Escolha os dados. Gere uma prévia e trave o que quiser manter.</p>
  <label>Nome <button type="button" class="tg-help" data-tooltip="{{help.name}}" data-tooltip-direction="RIGHT" aria-label="Ajuda sobre o nome">?</button><span class="tg-field"><input data-field="name" value="{{draft.name}}" placeholder="Digite um nome" maxlength="120"><button type="button" data-action="do" data-do="lock" data-key="name" class="tg-lock {{#if locks.name}}locked{{/if}}" aria-pressed="{{#if locks.name}}true{{else}}false{{/if}}" title="Travar nome"><i class="fa-solid {{#if locks.name}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></span></label>
  <label>Raça <span class="tg-field"><select data-field="race" {{#if locks.race}}disabled{{/if}}>{{#each races}}<option value="{{key}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}</option>{{/each}}</select><button type="button" data-action="do" data-do="lock" data-key="race" class="tg-lock {{#if locks.race}}locked{{/if}}" title="Travar raça"><i class="fa-solid {{#if locks.race}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></span></label>
  <label>Profissão <span class="tg-field"><select data-field="profession" {{#if locks.profession}}disabled{{/if}}>{{#each professions}}<option value="{{key}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}</option>{{/each}}</select><button type="button" data-action="do" data-do="lock" data-key="profession" class="tg-lock {{#if locks.profession}}locked{{/if}}" title="Travar profissão"><i class="fa-solid {{#if locks.profession}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></span></label>
  <label>Estágio (1–50) <span class="tg-field"><input data-field="stage" type="number" min="1" max="50" step="1" value="{{draft.stage}}" {{#if locks.stage}}disabled{{/if}}><button type="button" data-action="do" data-do="lock" data-key="stage" class="tg-lock {{#if locks.stage}}locked{{/if}}" title="Travar estágio"><i class="fa-solid {{#if locks.stage}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></span></label>
  <label>Especialização <button class="tg-help" type="button" data-tooltip="{{help.specialization}}" data-tooltip-direction="RIGHT" aria-label="Ajuda sobre especialização">?</button><span class="tg-field"><select data-field="specialization" {{#if locks.specialization}}disabled{{/if}}>{{#each specializations}}<option value="{{key}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}</option>{{/each}}</select><button type="button" data-action="do" data-do="lock" data-key="specialization" class="tg-lock {{#if locks.specialization}}locked{{/if}}" title="Travar especialização"><i class="fa-solid {{#if locks.specialization}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></span></label>
  {{#if restriction}}<p class="tg-hint">{{restriction}}</p>{{/if}}
  <label>Kit de pertences <button class="tg-help" type="button" data-tooltip="{{help.kit}}" data-tooltip-direction="RIGHT" aria-label="Ajuda sobre kits">?</button><select data-field="kit" {{#if locks.equipment}}disabled{{/if}}>{{#each kits}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
  <details class="tg-identity-options" data-section="identity" {{#if identityOpen}}open{{/if}}><summary>Identidade sugerida <button type="button" class="tg-help" data-tooltip="{{help.identity}}" data-tooltip-direction="RIGHT" aria-label="Ajuda sobre identidade">?</button></summary>
   <label>Classe social <input type="text" value="Livre" readonly></label>
   {{#each identityFields}}<label>{{label}}<span class="tg-field"><input data-field="identity:{{key}}" type="{{type}}" min="0" step="any" value="{{value}}"><button type="button" data-action="do" data-do="lock" data-key="identity:{{key}}" class="tg-lock {{#if locked}}locked{{/if}}" title="Travar {{label}}"><i class="fa-solid {{#if locked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></span></label>{{/each}}
   <label>Deus <span class="tg-field"><select data-field="identity:deus">{{#each deities}}<option value="{{key}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}</option>{{/each}}</select><button type="button" data-action="do" data-do="lock" data-key="identity:deus" class="tg-lock {{#if deityLocked}}locked{{/if}}" title="Travar deus"><i class="fa-solid {{#if deityLocked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></span></label>
  </details>
  <label>Distribuição <select data-field="distribution">{{#each distribution}}<option value="{{key}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}</option>{{/each}}</select></label>
  <label>EH <button type="button" class="tg-help" data-tooltip="{{help.eh}}" data-tooltip-direction="RIGHT" aria-label="Ajuda sobre EH">?</button><select data-field="ehMode">{{#each ehModes}}<option value="{{key}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}</option>{{/each}}</select></label>
  <button type="button" class="tg-primary" data-action="do" data-do="generate"><i class="fa-solid fa-dice"></i> {{#if preview}}Sortear novamente{{else}}Gerar prévia{{/if}}</button>
  <button type="button" class="tg-subtle" data-action="do" data-do="unlock">Abrir todas as travas <i class="fa-solid fa-lock-open"></i></button>
  <p class="tg-note">Prévia 0.1 · Distribuição por pontos. Você decide a identidade, a história e os requisitos narrativos.</p>
 </aside>
 <main class="tg-preview">
  <h2>Prévia <button type="button" class="tg-help" data-tooltip="{{help.locks}}" data-tooltip-direction="LEFT" aria-label="Ajuda sobre as travas">?</button></h2>
  {{#if error}}<p class="tg-error" role="alert">{{error}}</p>{{/if}}
  <p class="tg-dirty" {{#unless dirty}}hidden{{/unless}}>Configuração alterada. Gere novamente para atualizar a prévia.</p>
  {{#if preview}}
   <div class="tg-identity"><strong>{{preview.actor.name}}</strong><span>{{preview.actor.system.raca}} · {{preview.actor.system.profissao}} · Estágio {{preview.actor.system.estagio}}</span>{{#if preview.actor.system.especializacao}}<small>{{preview.actor.system.especializacao}}</small>{{/if}}<small>{{preview.actor.system.classe_social}} · {{preview.actor.system.idade}} anos · {{preview.actor.system.altura}} m · {{preview.actor.system.peso}} kg · Deus: {{preview.actor.system.deus}}</small></div>
   <div class="tg-stats">{{#each stats}}<span>{{label}}<b>{{value}}</b></span>{{/each}}</div>
   <details data-section="attributes" {{#if attributesOpen}}open{{/if}}>
    <summary>Atributos <button type="button" class="tg-help" data-tooltip="{{help.attrs}}" aria-label="Ajuda sobre atributos">?</button></summary>
    <div class="tg-attributes">{{#each attributes}}<label>{{key}}<input type="number" data-field="attr:{{key}}" value="{{value}}" min="-4" max="10" step="1"><span>Racial {{racial}} <button type="button" class="tg-lock {{#if locked}}locked{{/if}}" data-action="do" data-do="lock" data-key="attr:{{key}}" title="Travar {{key}}"><i class="fa-solid {{#if locked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></span></label>{{/each}}</div>
   </details>
   <div class="tg-balances" title="Pontos restantes para comprar na ficha">{{#each balances}}<span>{{label}}: <b>{{value}}</b></span>{{/each}}</div>
   <div class="tg-row"><span>EH: {{preview.actor.system.eh.max}} <button type="button" class="tg-help" data-tooltip="{{help.eh}}" aria-label="Ajuda sobre a EH sorteada">?</button></span><button type="button" class="tg-lock {{#if ehLocked}}locked{{/if}}" data-action="do" data-do="lock" data-key="eh" title="Conservar os dados de EH"><i class="fa-solid {{#if ehLocked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></div>
   <details class="tg-eh"><summary>Conferir evolução de EH</summary><p>{{ehInfo}}</p></details>
   <div class="tg-row"><span>Grupos de armas <button type="button" class="tg-help" data-tooltip="{{help.groups}}" aria-label="Ajuda sobre grupos de armas">?</button></span><button type="button" class="tg-lock {{#if groupsLocked}}locked{{/if}}" data-action="do" data-do="lock" data-key="groups" title="Travar grupos de armas"><i class="fa-solid {{#if groupsLocked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></div>
   <div class="tg-groups">{{#each groups}}<span>{{key}} <b>{{value}}</b></span>{{else}}<small>Nenhum grupo comprado.</small>{{/each}}</div>
   {{#each sections}}
    <details data-section="{{key}}" {{#if open}}open{{/if}}>
     <summary><span>{{label}} <small>({{count}})</small> <button type="button" class="tg-help" data-tooltip="{{help}}" aria-label="Ajuda sobre {{label}}">?</button></span><button type="button" class="tg-lock {{#if locked}}locked{{/if}}" data-action="do" data-do="lock" data-key="{{key}}" title="Travar {{label}}"><i class="fa-solid {{#if locked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></summary>
     {{#if skills}}<div class="tg-skill-grid">{{#each skillGroups}}<section class="tg-skill-group"><h3>{{label}}</h3><table class="tg-skill-table tg-character-skills"><thead><tr><th>Habilidade</th><th>Nível</th><th>Total</th><th>Ajustar</th></tr></thead><tbody>{{#each items}}<tr data-skill-key="{{key}}"><td><span class="tg-skill-name"><img src="{{img}}" alt="" loading="lazy"><span>{{name}}{{#if innate}} <small title="Habilidade nata: acompanha o estágio sem gastar pontos">(nata)</small>{{/if}}{{#if noLevel}} <small title="Exige nível para usar">*</small>{{/if}}</span></span></td><td>{{level}}</td><td>{{total}}</td><td class="tg-actions">{{#unless innate}}<button type="button" data-action="do" data-do="item-down" data-key="{{key}}" title="Reduzir nível de {{name}}">−</button><button type="button" data-action="do" data-do="item-up" data-key="{{key}}" title="Aumentar nível de {{name}}">+</button>{{/unless}}<button type="button" class="tg-lock {{#if locked}}locked{{/if}}" data-action="do" data-do="lock" data-key="item:{{key}}" title="Travar {{name}}"><i class="fa-solid {{#if locked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button>{{#unless innate}}<button type="button" data-action="do" data-do="item-remove" data-key="{{key}}" title="Zerar nível de {{name}}; manter na ficha"><i class="fa-solid fa-rotate-left"></i></button>{{/unless}}</td></tr>{{else}}<tr><td colspan="4">Nenhuma habilidade neste grupo.</td></tr>{{/each}}</tbody></table></section>{{/each}}</div><p class="tg-hint">Todas as habilidades aparecem, inclusive sem nível. + e − usam os pontos e limites da profissão. O cadeado preserva a escolha; ↶ zera o nível. A nata acompanha o estágio. * Exige treinamento para usar.</p>{{else}}
     <table><thead><tr><th>Item</th><th>Nível</th><th>Total / dados</th><th>Editar</th></tr></thead><tbody>{{#each items}}<tr><td><img src="{{img}}" alt="" loading="lazy"><span>{{name}}{{#if innate}} <small>(nata)</small>{{/if}}</span></td><td>{{#if canLevel}}{{level}}{{else}}—{{/if}}</td><td>{{total}}</td><td class="tg-actions">{{#if canLevel}}{{#unless innate}}<button type="button" data-action="do" data-do="item-down" data-key="{{key}}" title="Reduzir nível">−</button><button type="button" data-action="do" data-do="item-up" data-key="{{key}}" title="Aumentar nível">+</button>{{/unless}}{{/if}}<button type="button" class="tg-lock {{#if locked}}locked{{/if}}" data-action="do" data-do="lock" data-key="item:{{key}}" title="Travar {{name}}"><i class="fa-solid {{#if locked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button>{{#unless innate}}<button type="button" data-action="do" data-do="item-remove" data-key="{{key}}" title="Retirar {{name}}"><i class="fa-solid fa-trash"></i></button>{{/unless}}</td></tr>{{else}}<tr><td colspan="4">Nenhum item neste bloco.</td></tr>{{/each}}</tbody></table>
     {{/if}}
     <details class="tg-add"><summary>+ Escolher outro item</summary><div class="tg-item-picker" data-item-picker><div class="tg-combo-field"><input type="search" role="combobox" aria-autocomplete="list" aria-expanded="false" autocomplete="off" data-item-search="{{key}}" placeholder="Procurar e escolher item..." aria-label="Procurar {{label}}"><button type="button" data-picker-toggle aria-label="Abrir opções de {{label}}" tabindex="-1"><i class="fa-solid fa-caret-down" aria-hidden="true"></i></button></div><select data-add="{{key}}" hidden><option value="">Escolha um item</option>{{#each candidates}}<option value="{{key}}" title="{{title}}">{{name}}</option>{{/each}}</select><button type="button" data-action="do" data-do="item-add" data-section="{{key}}">Adicionar</button><div class="tg-item-options" role="listbox" aria-label="Opções de {{label}}" hidden></div></div><small>Usa os pontos disponíveis. Para trocar, retire ou diminua outro item primeiro.</small></details>
    </details>
   {{/each}}
   {{#if preview.warnings}}<details class="tg-review"><summary>Conferir observações ({{preview.warnings.length}})</summary>{{#each preview.warnings}}<p>{{this}}</p>{{/each}}</details>{{/if}}
  {{else}}<div class="tg-empty"><i class="fa-solid fa-user-plus"></i><p>Seu próximo personagem começa aqui.</p><small>Selecione raça, profissão e estágio e clique em Gerar prévia.</small></div>{{/if}}
 </main>
 </div>
 <footer class="tg-footer"><label>Criar na pasta <select data-field="folder">{{#each folders}}<option value="{{key}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}</option>{{/each}}</select></label><button type="button" class="tg-help" data-tooltip="{{help.create}}" aria-label="Ajuda para criar a ficha">?</button>{{#if created}}<button type="button" class="tg-primary" data-action="do" data-do="open">Abrir ficha criada</button>{{else}}<button type="button" class="tg-primary" data-action="do" data-do="create" {{#unless preview}}disabled{{/unless}} {{#if dirty}}disabled{{/if}} {{#if busy}}disabled{{/if}}><i class="fa-solid fa-user-plus"></i> Criar ficha no mundo</button>{{/if}}</footer>
 {{/if}}
 {{/if}}
</div>
