{{#*inline "question"}}{{#with (lookup @root.help key)}}<button type="button" class="tv-question" data-action="do" data-command="help" data-value="{{../key}}" title="{{text}}" aria-label="Ajuda: {{title}}">?</button>{{/with}}{{/inline}}
{{#*inline "parameters"}}
<div class="tv-parameters"><div class="tv-grid">
{{#if typeChoices}}<label>Tipo de transporte<select data-edit data-profile-type name="{{prefix}}type">{{#each typeChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
<label class="tv-wide">Nome do transporte<input data-edit name="{{prefix}}name" value="{{name}}" maxlength="120"></label>
<label><span>Informar em {{> question key="unit"}}</span><select data-edit data-speed-mode name="{{prefix}}speedMode">{{#each units}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
<label><span><span data-speed-label>{{speedLabel}}</span> {{> question key="speed"}}</span><input data-edit type="number" name="{{prefix}}base" value="{{base}}" min="0" max="10000" step="any"></label>
<label><span>Jornada (h/dia) {{> question key="work"}}</span><input data-edit type="number" name="{{prefix}}work" value="{{work}}" min="0.01" max="24" step="any" {{#if started}}readonly{{/if}}></label>
{{#if sizeAvailable}}<label {{#if typeChoices}}data-profile-size {{#unless usesSize}}hidden{{/unless}}{{/if}}><span>Porte {{> question key="size"}}</span><select data-edit name="{{prefix}}size">{{#each sizes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
{{#if animalsAvailable}}<label {{#if typeChoices}}data-profile-animals {{#unless usesAnimals}}hidden{{/unless}}{{/if}}><span>Animais {{> question key="animals"}}</span><input data-edit type="number" name="{{prefix}}animals" value="{{animals}}" min="0" max="1000" step="1"></label>{{/if}}
</div><details class="tv-conditions" data-travel-detail="conditions-{{prefix}}"><summary>Condições do percurso</summary><div class="tv-grid">
{{#each factors}}<label class="tv-factor"><span>{{label}} {{> question key=key}}</span><select data-factor-choice aria-label="{{label}}">{{#each choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select><input data-edit data-factor-value type="number" name="{{name}}" value="{{value}}" min="0" max="5" step="any" aria-label="Fator personalizado: {{label}}" {{#unless custom}}hidden{{/unless}}></label>{{/each}}
</div><p class="tv-note">As sugestões ajustam a velocidade. “Personalizado” aceita outro fator; 1 é neutro.</p></details></div>
{{/inline}}
<div class="tv-shell">
<header class="tv-heading"><div><h2><i class="fa-solid fa-route" aria-hidden="true"></i> Viagens e Expedições</h2><p>Planeje os trechos. Acompanhe a jornada.</p></div><span class="tv-badge">1.0.3</span></header>
<div class="tv-route-picker tv-toolbar"><label>Viagem<select data-route-picker {{#unless hasTrip}}disabled{{/unless}}>{{#each trips}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{else}}<option>Crie sua primeira viagem</option>{{/each}}</select></label><button type="button" data-action="do" data-command="new" {{#unless editable}}disabled{{/unless}}>+ Nova viagem</button>{{#unless isProfiles}}{{#if hasTrip}}<button class="tv-delete-trip" type="button" data-action="do" data-command="delete" title="Excluir a viagem selecionada" aria-label="Excluir a viagem selecionada" {{#unless editable}}disabled{{/unless}}><i class="fa-solid fa-trash" aria-hidden="true"></i> Excluir</button>{{/if}}{{/unless}}</div>
<nav class="tv-tabs" aria-label="Etapas da viagem">{{#each views}}<button type="button" data-action="do" data-command="view" data-value="{{value}}" class="{{#if selected}}active{{/if}}" aria-pressed="{{selected}}">{{label}}</button>{{/each}}</nav>

<div class="tv-toolbar tv-status"><span data-dirty aria-live="polite">{{#if profileDraft}}Novo transporte — salve para registrar{{else}}Salvo no mundo{{/if}}</span><button type="button" data-action="do" data-command="reload">↻ Recarregar</button></div>
{{#unless editable}}<p class="tv-warning">Somente leitura. Mestre coordenador: {{coordinator}}.</p>{{/unless}}
<form autocomplete="off"><fieldset class="tv-body" {{#unless editable}}disabled{{/unless}}>
{{#if isProfiles}}
<h3>Transportes salvos {{> question key="profile"}}</h3>
<div class="tv-profile-picker tv-toolbar"><label>Escolher transporte<select data-profile-picker {{#unless hasProfiles}}disabled{{/unless}}>{{#if profileDraft}}<option value="" selected disabled>Novo transporte (não salvo)</option>{{/if}}{{#each profileChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{else}}{{#unless profileDraft}}<option value="">Nenhum transporte salvo</option>{{/unless}}{{/each}}</select></label><button type="button" data-action="do" data-command="newProfile" {{#if profileDraft}}disabled{{/if}}>+ Criar transporte</button><button type="button" data-action="do" data-command="deleteProfile" {{#unless hasProfiles}}disabled{{/unless}} {{#if profileDraft}}disabled{{/if}} title="Excluir o transporte escolhido">Excluir</button></div>
{{#if profile}}<p class="tv-note">{{#if profileDraft}}Escolha o tipo, preencha os atributos e salve para registrar na lista.{{else}}Escolha na lista para consultar ou editar. Os trechos das viagens mantêm suas próprias cópias.{{/if}}</p>
{{#with profile}}{{> parameters this}}{{/with}}<div class="tv-toolbar tv-save"><button class="tv-primary" type="button" data-action="do" data-command="saveProfile">Salvar transporte</button>{{#if profileDraft}}<button type="button" data-action="do" data-command="cancelProfile">Cancelar</button>{{else}}<button type="button" data-action="do" data-command="copyProfile">Duplicar</button>{{/if}}</div>{{else}}<p class="tv-empty">Clique em Criar transporte para começar.</p>{{/if}}
{{else}}{{#if hasTrip}}{{#if isMap}}
<div class="tv-toolbar tv-trip-name-row"><label class="tv-trip-name">Nome da viagem<input data-edit name="trip.name" value="{{trip.name}}" maxlength="120" {{#if mapDraft}}readonly{{/if}}></label><button type="button" data-action="do" data-command="saveName" {{#if mapDraft}}disabled{{/if}}>Salvar nome</button></div>
<h3>Mapa do itinerário {{> question key="map"}}</h3>
<div class="tv-toolbar tv-map-library-actions"><button type="button" data-action="do" data-command="mapAdd" aria-expanded="{{mapCreatorOpen}}" aria-controls="tv-map-creator-{{trip.id}}" {{#if mapDraft}}disabled{{/if}}>+ Adicionar mapa</button></div>
<section class="tv-map-creator" id="tv-map-creator-{{trip.id}}" {{#unless mapCreatorOpen}}hidden{{/unless}} aria-label="Adicionar ou salvar mapa">
{{#if trip.canSetMap}}
{{#if hasScenes}}<div class="tv-map-source"><label>Escolher mapa<select name="mapSceneId">{{#each scenes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><button class="tv-primary" type="button" data-action="do" data-command="mapScene">Usar imagem de fundo e escala</button></div><p class="tv-note">Copia a imagem e a escala da cena, sem abrir ou alterar a cena original.</p>{{else}}<p class="tv-note">Nenhuma cena disponível. Você pode usar um arquivo de imagem.</p>{{/if}}
<details class="tv-map-file-options"><summary>Usar arquivo de imagem (opcional)</summary><div class="tv-map-source"><label>Imagem do mapa<input data-edit name="mapSrc" value="{{trip.map.src}}" placeholder="worlds/seu-mundo/mapas/tagmar.webp"></label><button type="button" data-action="do" data-command="mapBrowse" title="Escolher uma imagem do Foundry">Procurar</button><button type="button" data-action="do" data-command="mapLoad">Carregar mapa</button></div></details>
{{/if}}
{{#if trip.map}}<div class="tv-map-source"><label>Salvar o mapa atual com outro nome<input name="mapSaveName" value="{{mapSaveName}}" maxlength="120"></label><button type="button" data-action="do" data-command="mapStore">Salvar como novo mapa</button></div><p class="tv-note">Guarda uma cópia da imagem e da escala atuais na lista, sem caminhos ou progresso.</p>{{/if}}
</section>
{{#if hasSavedMaps}}<div class="tv-map-source"><label>Mapas salvos<select name="savedMapId">{{#each savedMaps}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{#if trip.canSetMap}}<button type="button" data-action="do" data-command="mapUse" {{#if trip.hasMappedSegments}}disabled{{/if}}>Usar mapa e escala</button>{{/if}}<button type="button" data-action="do" data-command="mapForget" title="Remover só da biblioteca; preserva imagens e mapas das viagens">Remover da lista</button></div>{{/if}}
<p class="tv-note">Novas viagens usam o último mapa escolhido e sua escala. Cada viagem mantém sua própria cópia.</p>
{{#if trip.started}}<p class="tv-note">Esta viagem já foi avançada. Você pode anexar um mapa para consulta; para desenhar ou alterar o caminho, duplique a viagem e preserve o progresso atual.</p><button type="button" data-action="do" data-command="duplicate">Duplicar viagem para planejar no mapa</button>{{/if}}
{{#if trip.map}}
{{#if trip.map.sourceScene}}<p class="tv-note">Mapa copiado de: {{trip.map.sourceScene.name}}.</p>{{/if}}
<div class="tv-map-tools tv-toolbar">
{{#unless trip.started}}
{{#unless mapDraft}}<button type="button" data-action="do" data-command="mapScale">Calibrar escala</button><label>Transporte<select name="mapProfile">{{#each mapProfiles}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><button class="tv-primary" type="button" data-action="do" data-command="mapDraw">Traçar trecho</button>{{else}}
{{#if isCalibrating}}<label>Distância conhecida (km)<input type="number" name="calibrationKm" value="{{calibrationKm}}" min="0.000001" max="10000000" step="any"></label>{{/if}}
<button class="tv-primary" type="button" data-action="do" data-command="mapSave">{{#if isCalibrating}}Salvar escala{{else}}Salvar trecho{{/if}}</button><button type="button" data-action="do" data-command="mapBack">Retirar último ponto</button><button type="button" data-action="do" data-command="mapCancel">Cancelar</button>
{{/unless}}{{/unless}}
<button type="button" data-action="do" data-command="mapZoom" data-value="0.5" title="Aumentar mapa">+</button><button type="button" data-action="do" data-command="mapZoom" data-value="-0.5" title="Diminuir mapa">−</button>
</div>
<p class="tv-note">{{trip.scaleText}} · Linhas: <span class="tv-key foot">A pé</span> · <span class="tv-key mount">Montaria</span> · <span class="tv-key cart">Carroça</span> · <span class="tv-key ship">Embarcação</span></p>
<div class="tv-map-host" data-map-host tabindex="0" title="Arraste com o botão direito para mover; use a rodinha para ampliar ou reduzir no ponto do mouse"></div><p class="tv-map-status" data-map-status aria-live="polite"></p>
<ol class="tv-itinerary">{{#each trip.segments}}<li><span class="tv-leg-label" style="--leg-color:{{color}}">{{index}}. {{name}}</span><span>{{distanceText}} km {{#if mapped}}<button type="button" data-action="do" data-command="mapEdit" data-id="{{id}}" {{#if @root.trip.started}}disabled{{/if}}>Editar caminho</button>{{else}}· Distância manual{{/if}}</span></li>{{/each}}</ol>
{{else}}<p class="tv-empty">Escolha uma cena ou imagem acima. Se a cena já tiver escala válida, ela será aproveitada; caso contrário, calibre por dois pontos de distância conhecida.</p>{{/if}}
{{else}}{{#if isPlan}}
{{#with trip}}
<details class="tv-departure" data-travel-detail="departure-{{id}}"><summary>Partida · dia {{departureDay}}, {{departureTime}} {{> question key="departure"}}</summary><div class="tv-grid"><label>Dia de partida<input data-edit type="number" name="trip.departureDay" value="{{departureDay}}" min="1" step="1" {{#if started}}readonly{{/if}}></label><label>Horário<input data-edit type="time" name="trip.departureTime" value="{{departureTime}}" {{#if started}}readonly{{/if}}></label><label class="tv-wide">Referência de data (opcional)<input data-edit name="trip.dateLabel" value="{{dateLabel}}" placeholder="Ex.: 18 de Água de 1522" maxlength="120"></label></div></details>
<section class="tv-summary" aria-label="Resumo salvo"><div><small>Distância total</small><strong>{{distance}} km</strong></div><div><small>Tempo estimado {{> question key="estimate"}}</small><strong>{{totalEstimate}}</strong></div><div><small>Chegada estimada</small><strong>{{eta}}</strong></div></section>{{/with}}
<h3>Itinerário planejado {{> question key="distance"}}</h3><p class="tv-note">Trace os trechos na aba Mapa. Aqui, confira a ordem, as distâncias, as condições de transporte e as paradas.</p>
{{#unless trip.started}}<details class="tv-manual-route" data-travel-detail="manual-{{trip.id}}"><summary>Adicionar trecho sem mapa (opcional)</summary><div class="tv-add-row"><label>Transporte<select name="addProfile">{{#each profiles}}<option value="{{value}}">{{label}}</option>{{/each}}</select></label><label class="tv-distance"><span>Distância (km) {{> question key="distance"}}</span><input type="number" name="addDistance" value="50" min="0" max="10000000" step="any"></label><button class="tv-primary" type="button" data-action="do" data-command="add">+ Adicionar trecho</button></div></details>{{else}}<p class="tv-note">Viagem iniciada: ajustes de velocidade afetam somente o caminho restante. Duplique para alterar a ordem dos trechos.</p>{{/unless}}
{{#each trip.segments}}<section class="tv-segment"><header class="tv-segment-head"><strong class="tv-leg-label" style="--leg-color:{{color}}">{{index}}. {{name}} {{#if done}}✓{{/if}}</strong><span>{{speed}} km/h · {{work}} h/dia</span></header>
<div class="tv-segment-basics"><label class="tv-distance">Distância (km)<input data-edit type="number" name="{{prefix}}distance" value="{{#if mapped}}{{roundedDistance}}{{else}}{{distance}}{{/if}}" min="0" max="10000000" step="any" {{#if mapped}}readonly{{/if}} {{#if started}}readonly{{/if}} {{#if done}}readonly{{/if}}></label>
<div class="tv-segment-timing" title="{{durationHint}}"><small>Duração estimada</small><strong>{{durationText}}</strong></div>
{{#unless @root.trip.started}}<div class="tv-segment-actions"><button type="button" data-action="do" data-command="up" data-id="{{id}}" title="Subir trecho" {{#if first}}disabled{{/if}}>↑</button><button type="button" data-action="do" data-command="down" data-id="{{id}}" title="Descer trecho" {{#if @last}}disabled{{/if}}>↓</button><button type="button" data-action="do" data-command="remove" data-id="{{id}}">Remover</button></div>{{else}}<span class="tv-note">{{doneKm}} km percorridos</span>{{/unless}}</div>
<details class="tv-segment-options" data-travel-detail="segment-{{id}}"><summary>Ajustar transporte e paradas</summary><fieldset class="tv-segment-content" {{#if done}}disabled{{/if}}>{{> parameters this}}<label class="tv-wait"><span>Espera antes de partir (h) {{> question key="wait"}}</span><input data-edit type="number" name="{{prefix}}wait" value="{{wait}}" min="0" max="1000000" step="any" {{#if started}}readonly{{/if}}></label></fieldset></details></section>
{{else}}<div class="tv-empty"><p>Comece traçando o caminho no mapa; as distâncias serão calculadas pela escala salva.</p><button type="button" data-action="do" data-command="view" data-value="map">Planejar caminho no mapa →</button></div>{{/each}}
<div class="tv-toolbar tv-save"><button class="tv-primary" type="button" data-action="do" data-command="save">Salvar roteiro e recalcular</button><button type="button" data-action="do" data-command="view" data-value="track">Acompanhar →</button></div>
<details class="tv-more"><summary>Mais opções da viagem</summary><div class="tv-toolbar"><button type="button" data-action="do" data-command="duplicate">Duplicar sem progresso</button><button type="button" data-action="do" data-command="undo" {{#unless trip.canUndo}}disabled{{/unless}}>Desfazer última alteração</button></div></details>
{{else}}{{#with trip}}
<section class="tv-summary" aria-label="Progresso da viagem"><div><small>{{status}}</small><strong>{{done}} / {{distance}} km</strong><progress value="{{percent}}" max="100" aria-label="Progresso da viagem"></progress><span>Faltam {{remaining}} km</span></div><div><small>Horário da viagem</small><strong>{{current}}</strong><span>Decorridos {{elapsedText}}</span></div><div><small>Chegada estimada {{> question key="estimate"}}</small><strong>{{eta}}</strong><span>Restam {{remainingTime}}</span></div></section>
<div class="tv-clock-link tv-toolbar">{{#if linked}}<span>📅 Esta viagem acompanha o calendário.</span><button type="button" data-action="do" data-command="unlinkClock">Desvincular</button>{{else}}<span>{{#if clockMissing}}Ative o Grande Calendário para retomar o vínculo.{{else}}Avanço independente.{{/if}}</span>{{#if @root.clockAvailable}}<button type="button" class="tv-primary" data-action="do" data-command="linkClock" {{#unless hasSegments}}disabled{{/unless}}>Vincular esta viagem ao calendário</button>{{/if}}{{/if}}</div>
{{#if beforeLink}}<p class="tv-note">O relógio está antes do momento do vínculo. O progresso anterior foi preservado.</p>{{/if}}
<section class="tv-stage"><small>{{#if stage.index}}Trecho {{stage.index}} · {{stage.name}}{{else}}{{stage.name}}{{/if}}</small><h3>{{#if paused}}Viagem pausada{{else}}{{stage.label}}{{/if}}</h3>{{#if stage.index}}<p>Faltam {{stage.remaining}} km neste trecho.{{#if stage.untilNext}} Próxima etapa em {{stage.untilNext}}{{#if paused}} após retomar{{/if}}.{{/if}}</p>{{/if}}</section>
{{#if blocked}}<p class="tv-warning">{{blocked}} Ajuste a velocidade em Planejar para continuar.</p>{{/if}}
<div class="tv-advance tv-toolbar"><label><span>Avançar horas {{> question key="advance"}}</span><input type="number" name="advanceHours" value="1" min="0.001" max="1000000" step="any"></label><button class="tv-hour" type="button" data-action="do" data-command="advance" data-value="-1" title="Voltar 1 hora no calendário e na viagem" {{#unless canRewind}}disabled{{/unless}}>◀ H</button><button class="tv-hour" type="button" data-action="do" data-command="advance" title="Avançar as horas informadas" {{#unless canTimeAdvance}}disabled{{/unless}}>H ▶</button><button class="tv-day" type="button" data-action="do" data-command="advance" data-value="-24" title="Voltar 1 dia no calendário e na viagem" {{#unless canRewind}}disabled{{/unless}}>◀ D</button><button class="tv-day" type="button" data-action="do" data-command="advance" data-value="24" {{#unless canTimeAdvance}}disabled{{/unless}}>D ▶</button><button class="tv-pause" type="button" data-action="do" data-command="pause">{{#if paused}}Retomar{{else}}Pausar{{/if}}</button><button type="button" data-action="do" data-command="undo" {{#unless canUndo}}disabled{{/unless}}>Desfazer</button>{{> question key="undo"}}</div>
<button type="button" data-action="do" data-command="compact">Abrir acompanhamento compacto</button>
<p class="tv-note">{{#if linked}}Os botões mudam o calendário e o acompanhamento. Parar suspende só o deslocamento; o relógio continua.{{else}}Vincule ao calendário para sincronizar horas e dias. Sem vínculo, o avanço afeta só esta viagem.{{/if}}</p>
<details class="tv-breakdown" data-travel-detail="breakdown-{{id}}"><summary>Tempos e roteiro completo</summary><p class="tv-note">Já decorridos: movimento {{movingText}} · descanso {{restingText}} · espera {{waitingText}}.</p><ol class="tv-itinerary">{{#each segments}}<li><strong>{{name}}</strong><span>{{doneKm}} / {{distance}} km · {{speed}} km/h {{#if done}}✓{{/if}}</span></li>{{/each}}</ol><p class="tv-note">Última ação: {{lastAction}}.</p></details>
{{/with}}{{/if}}{{/if}}
{{else}}<div class="tv-empty"><h3>Sua próxima expedição começa aqui</h3><p>Crie uma viagem, adicione os trechos e informe as distâncias.<br>Depois, acompanhe o progresso com avanço manual.</p><button type="button" data-action="do" data-command="example">Experimentar roteiro de exemplo</button></div>{{/if}}{{/if}}
</fieldset></form>
<details class="tv-help"><summary>Como a estimativa funciona</summary><p>Velocidade = média em km/h (ou VB × 0,24) × ritmo × caminho × carga × cansaço. As sugestões são estimativas ajustáveis, não regras oficiais.</p><p>Cada trecho inicia um ciclo de jornada e descanso. Não há descanso após chegar. Para parar entre transportes, informe uma espera no trecho seguinte. Depois de iniciar, duplique para mudar a ordem dos trechos.</p><p>O vínculo ao Grande Calendário sincroniza uma viagem por vez. Sem vento, consumo de recursos ou cansaço automático nesta versão. Use uma única aba de edição por conta.</p></details>
<dialog class="tv-help-dialog" aria-label="Ajuda do planejador"><h3></h3><p></p><button type="button" data-action="do" data-command="closeHelp" autofocus>Entendi</button></dialog>
</div>
